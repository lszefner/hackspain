# Proveedor de la fase 2 (vision + interpretacion).
# Los NOMBRES son identicos a los de la rama main a proposito: el .env que ya
# usabais alli funciona aqui sin editar una linea.
HELMCODE_BASE_URL=
HELMCODE_API_KEY=
HELMCODE_VISION_MODEL=gemma4
HELMCODE_LAYOUT_MODEL=qwen3.6

# Solo si se activa el paso de interpretacion (--interpretar).
HELMCODE_DEEPSEEK_MODEL=

# La Caja, si no esta en ./caja
# ALBERTO_CAJA=/ruta/a/500-sombras-de-alberto
