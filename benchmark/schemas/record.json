{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "record",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "file_id": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reading_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "pending",
        "success",
        "invalid",
        "failed",
        "blocked"
      ]
    },
    "provider": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "resolved_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "prompt_version": {
      "type": "string"
    },
    "latency_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "usage": {
      "type": "object"
    },
    "cost_usd": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?\\d+(\\.\\d+)?$"
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "imported": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "file_id",
    "source_sha256",
    "reading_sha256",
    "status",
    "provider",
    "model",
    "resolved_model",
    "prompt_version",
    "latency_seconds",
    "usage",
    "cost_usd",
    "attempts",
    "error",
    "artifact_sha256",
    "imported"
  ],
  "additionalProperties": false
}
