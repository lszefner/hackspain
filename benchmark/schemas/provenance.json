{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "provenance",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "file_id": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stage2": {
      "type": "object",
      "properties": {
        "author": {
          "type": "string"
        },
        "source": {
          "enum": [
            "codex_visual",
            "human_visual",
            "synthetic_fixture"
          ]
        },
        "status": {
          "enum": [
            "draft",
            "human_verified"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "complete": {
          "type": "boolean"
        },
        "inspected_pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "excluded_pointers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "author",
        "source",
        "status",
        "reviewer",
        "reviewed_at",
        "artifact_sha256",
        "complete",
        "inspected_pages",
        "excluded_pointers"
      ],
      "additionalProperties": false
    },
    "stage3": {
      "type": "object",
      "properties": {
        "author": {
          "type": "string"
        },
        "source": {
          "enum": [
            "codex_visual",
            "human_visual",
            "synthetic_fixture"
          ]
        },
        "status": {
          "enum": [
            "draft",
            "human_verified"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "complete": {
          "type": "boolean"
        },
        "inspected_pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "excluded_pointers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "author",
        "source",
        "status",
        "reviewer",
        "reviewed_at",
        "artifact_sha256",
        "complete",
        "inspected_pages",
        "excluded_pointers"
      ],
      "additionalProperties": false
    },
    "pointers": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "reference_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "page",
            "reference_ids"
          ],
          "additionalProperties": false
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "file_id",
    "source_sha256",
    "stage2",
    "stage3",
    "pointers",
    "unresolved"
  ],
  "additionalProperties": false
}
