{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reading",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "file_id": {
      "type": "string"
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "block_kinds": {
          "type": "boolean"
        },
        "tables": {
          "type": "boolean"
        },
        "layout": {
          "type": "boolean"
        }
      },
      "required": [
        "block_kinds",
        "tables",
        "layout"
      ],
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "heading",
                    "paragraph",
                    "table",
                    "note",
                    "stamp",
                    "footer",
                    "other"
                  ]
                },
                "text": {
                  "type": "string"
                },
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "cells": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "column": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "row_span": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "column_span": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "text": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "id",
                            "column",
                            "row_span",
                            "column_span",
                            "text"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "id",
                      "cells"
                    ],
                    "additionalProperties": false
                  }
                },
                "uncertainties": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "enum": [
                          "unreadable",
                          "uncertain"
                        ]
                      },
                      "raw_text": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "description": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "raw_text",
                      "description"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "kind",
                "text",
                "rows",
                "uncertainties"
              ],
              "additionalProperties": false
            }
          },
          "non_text_elements": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string"
                },
                "reference_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "description",
                "reference_ids"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "page",
          "blocks",
          "non_text_elements"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "file_id",
    "capabilities",
    "pages"
  ],
  "additionalProperties": false
}
