{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "run",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "run_id": {
      "type": "string"
    },
    "track": {
      "enum": [
        "ocr",
        "isolated",
        "end_to_end"
      ]
    },
    "provider": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "prompt_version": {
      "type": "string"
    },
    "config_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifest_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "split": {
      "enum": [
        "development",
        "held_out",
        "all"
      ]
    },
    "reading_run": {
      "type": [
        "string",
        "null"
      ]
    },
    "provisional": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string"
    },
    "config": {
      "type": "object"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "track",
    "provider",
    "model",
    "prompt_version",
    "config_hash",
    "manifest_hash",
    "split",
    "reading_run",
    "provisional",
    "created_at",
    "config",
    "documents"
  ],
  "additionalProperties": false
}
