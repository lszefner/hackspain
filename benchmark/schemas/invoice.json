{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "invoice",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "file_id": {
      "type": "string"
    },
    "document_type": {
      "enum": [
        "invoice",
        "credit_note",
        "other",
        "unknown"
      ]
    },
    "invoice_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "issue_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "purchase_order_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "currency": {
      "type": [
        "string",
        "null"
      ]
    },
    "supplier": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "tax_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        },
        "address": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "tax_id",
        "location",
        "address"
      ],
      "additionalProperties": false
    },
    "customer": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "tax_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        },
        "address": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "tax_id",
        "location",
        "address"
      ],
      "additionalProperties": false
    },
    "payment": {
      "type": "object",
      "properties": {
        "iban": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\S+$"
        }
      },
      "required": [
        "iban"
      ],
      "additionalProperties": false
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "position": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-?\\d+(\\.\\d+)?$"
          },
          "amount": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-?\\d+(\\.\\d+)?$"
          }
        },
        "required": [
          "position",
          "description",
          "quantity",
          "amount"
        ],
        "additionalProperties": false
      }
    },
    "taxes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "rate_percent": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-?\\d+(\\.\\d+)?$"
          },
          "amount": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-?\\d+(\\.\\d+)?$"
          }
        },
        "required": [
          "label",
          "rate_percent",
          "amount"
        ],
        "additionalProperties": false
      }
    },
    "totals": {
      "type": "object",
      "properties": {
        "taxable_base": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?\\d+(\\.\\d+)?$"
        },
        "total": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?\\d+(\\.\\d+)?$"
        }
      },
      "required": [
        "taxable_base",
        "total"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "note",
              "stamp",
              "footer",
              "other"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "additional_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "raw_value": {
            "type": "string"
          },
          "normalized_value": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "label",
          "raw_value",
          "normalized_value"
        ],
        "additionalProperties": false
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "pattern": "^(/.*)?$"
          },
          "kind": {
            "enum": [
              "unreadable",
              "ambiguous",
              "conflicting"
            ]
          },
          "raw_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "field",
          "kind",
          "raw_text",
          "candidates"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "file_id",
    "document_type",
    "invoice_number",
    "issue_date",
    "purchase_order_reference",
    "currency",
    "supplier",
    "customer",
    "payment",
    "lines",
    "taxes",
    "totals",
    "annotations",
    "additional_fields",
    "issues"
  ],
  "additionalProperties": false
}
