{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Traceable invoice decision context",
  "description": "Adapter output, not a replacement for invoice extraction schema 0.1. Runtime validation additionally verifies source hashes, pointers, authority, dependency completeness, and preflight consistency.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "context_id", "file_id", "adapter_version", "registry_version", "evaluation_date", "sources", "extraction", "ruleset", "fields", "rule_bindings", "findings", "reviews", "preflight"],
  "properties": {
    "schema_version": {"const": "decision-context/1"},
    "context_id": {"type": "string", "pattern": "^dc_[a-f0-9]{64}$"},
    "file_id": {"type": "string", "minLength": 1},
    "adapter_version": {"const": "decision-adapter/1"},
    "registry_version": {"const": "decision-fields/1"},
    "evaluation_date": {"type": "string", "format": "date"},
    "sources": {
      "type": "object",
      "minProperties": 5,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/$defs/source"}
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invoice", "reading", "evidence", "checks"],
      "properties": {
        "invoice": {"$ref": "#/$defs/name"},
        "reading": {"$ref": "#/$defs/name"},
        "evidence": {"$ref": "#/$defs/name"},
        "checks": {"$ref": "#/$defs/name"}
      }
    },
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "schema_version", "ruleset_version", "policy_id"],
      "properties": {
        "source": {"$ref": "#/$defs/name"},
        "schema_version": {"const": "2.0"},
        "ruleset_version": {"$ref": "#/$defs/name"},
        "policy_id": {"$ref": "#/$defs/name"}
      }
    },
    "fields": {
      "type": "object",
      "required": ["invoice.document_type", "invoice.number", "invoice.supplier_tax_id", "invoice.iban", "invoice.order_reference", "invoice.issue_date", "invoice.currency", "invoice.taxable_base", "invoice.total", "invoice.vat_amount", "invoice.line_amounts", "supplier.id", "supplier.tax_id", "supplier.iban", "supplier.city", "supplier.active", "supplier.payment_terms_days", "order.id", "order.supplier_id", "order.total", "order.currency", "erp.order_payment_status", "history.processed_matches", "history.approved_matches", "history.paid_matches"],
      "additionalProperties": false,
      "patternProperties": {
        "^(invoice\\.(number|supplier_tax_id|iban|order_reference)|supplier\\.(id|tax_id|iban|city)|order\\.(id|supplier_id))$": {"$ref": "#/$defs/stringFact"},
        "^invoice\\.document_type$": {
          "allOf": [{"$ref": "#/$defs/fact"}, {"properties": {"value": {"enum": ["invoice", "credit_note", "other", "unknown", null]}}}]
        },
        "^invoice\\.issue_date$": {
          "allOf": [{"$ref": "#/$defs/stringFact"}, {"properties": {"value": {"type": ["string", "null"], "format": "date"}}}]
        },
        "^(invoice|order)\\.currency$": {
          "allOf": [{"$ref": "#/$defs/stringFact"}, {"properties": {"value": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"}}}]
        },
        "^(invoice\\.(taxable_base|total|vat_amount)|order\\.total|invoice\\.(lines|taxes)\\.(0|[1-9][0-9]*)\\.amount)$": {"$ref": "#/$defs/decimalFact"},
        "^invoice\\.taxes\\.(0|[1-9][0-9]*)\\.kind$": {
          "allOf": [{"$ref": "#/$defs/fact"}, {"properties": {"value": {"enum": ["vat", "withholding", "other", "unknown", null]}}}]
        },
        "^invoice\\.line_amounts$": {
          "allOf": [{"$ref": "#/$defs/fact"}, {"properties": {"value": {"type": ["array", "null"], "items": {"$ref": "#/$defs/decimalOrNull"}}}}]
        },
        "^supplier\\.active$": {
          "allOf": [{"$ref": "#/$defs/fact"}, {"properties": {"value": {"type": ["boolean", "null"]}}}]
        },
        "^supplier\\.payment_terms_days$": {
          "allOf": [{"$ref": "#/$defs/fact"}, {"properties": {"value": {"type": ["integer", "null"], "minimum": 0}}}]
        },
        "^erp\\.order_payment_status$": {
          "allOf": [{"$ref": "#/$defs/fact"}, {"properties": {"value": {"enum": ["PENDIENTE", "PAGADA", null]}}}]
        },
        "^history\\.(processed|approved|paid)_matches$": {
          "allOf": [{"$ref": "#/$defs/fact"}, {"properties": {"value": {"type": ["array", "null"], "items": {"$ref": "#/$defs/sourceRef"}}}}]
        }
      }
    },
    "rule_bindings": {"type": "array", "items": {"$ref": "#/$defs/binding"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "reviews": {"type": "array", "items": {"$ref": "#/$defs/review"}},
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_status", "execution_status"],
      "properties": {
        "data_status": {"enum": ["ready", "blocked"]},
        "execution_status": {"enum": ["supported", "blocked"]}
      }
    }
  },
  "$defs": {
    "name": {"type": "string", "minLength": 1},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "pointer": {"type": "string", "pattern": "^(?:/(?:[^~/]|~[01])*)*$"},
    "decimalOrNull": {"type": ["string", "null"], "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "availability", "artifact_ref", "sha256", "captured_at", "as_of", "asserted_by", "authoritative_for", "scope"],
      "properties": {
        "kind": {"enum": ["invoice", "reading", "evidence", "extraction_checks", "supplier_master", "order_master", "erp", "history", "ruleset", "extraction_auxiliary", "master_workbook", "source_mapping"]},
        "availability": {"enum": ["available", "partial", "unavailable"]},
        "artifact_ref": {"type": ["string", "null"], "pattern": "^sha256/[a-f0-9]{2}/[a-f0-9]{64}/decision-source-[a-z_]+$"},
        "sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "captured_at": {"type": "string", "format": "date-time"},
        "as_of": {"type": ["string", "null"], "format": "date-time"},
        "asserted_by": {"$ref": "#/$defs/name"},
        "authoritative_for": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
        "scope": {"$ref": "#/$defs/name"}
      },
      "allOf": [{
        "if": {"properties": {"availability": {"const": "unavailable"}}},
        "then": {"properties": {"artifact_ref": {"type": "null"}, "sha256": {"type": "null"}}},
        "else": {"properties": {"artifact_ref": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"}}}
      }]
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "pointer"],
      "properties": {"source": {"$ref": "#/$defs/name"}, "pointer": {"$ref": "#/$defs/pointer"}}
    },
    "inputRef": {
      "oneOf": [
        {"$ref": "#/$defs/sourceRef"},
        {"type": "object", "additionalProperties": false, "required": ["field"], "properties": {"field": {"$ref": "#/$defs/name"}}}
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "state", "basis", "extraction_quality", "transform", "inputs"],
      "properties": {
        "value": {"type": ["string", "integer", "boolean", "array", "null"]},
        "state": {"enum": ["present", "missing", "ambiguous", "invalid", "unavailable"]},
        "basis": {"enum": ["observed", "normalized", "derived"]},
        "extraction_quality": {"enum": ["no_reported_issue", "uncertain", "unlinked", "not_applicable"]},
        "transform": {"type": "string", "pattern": "^[a-z][a-z0-9_]*/[1-9][0-9]*$"},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/inputRef"}}
      },
      "allOf": [{
        "if": {"properties": {"state": {"const": "present"}}},
        "then": {"properties": {"value": {"not": {"type": "null"}}, "inputs": {"minItems": 1}}},
        "else": {"properties": {"value": {"type": "null"}}}
      }]
    },
    "stringFact": {"allOf": [{"$ref": "#/$defs/fact"}, {"properties": {"value": {"type": ["string", "null"], "minLength": 1}}}]},
    "decimalFact": {"allOf": [{"$ref": "#/$defs/fact"}, {"properties": {"value": {"$ref": "#/$defs/decimalOrNull"}}}]},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "rule_pointer", "dependencies", "input_status", "execution_status", "reason_codes"],
      "properties": {
        "rule_id": {"$ref": "#/$defs/name"},
        "rule_pointer": {"type": "string", "pattern": "^/rules/(0|[1-9][0-9]*)$"},
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requested_name", "field_id", "state"],
            "properties": {
              "requested_name": {"$ref": "#/$defs/name"},
              "field_id": {"type": ["string", "null"], "minLength": 1},
              "state": {"enum": ["bound", "missing", "ambiguous", "invalid", "unavailable", "unknown_field"]}
            }
          }
        },
        "input_status": {"enum": ["ready", "blocked"]},
        "execution_status": {"enum": ["supported", "unsupported"]},
        "reason_codes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/name"}}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "field_ids", "rule_ids", "source_ids", "refs"],
      "properties": {
        "code": {"$ref": "#/$defs/name"},
        "severity": {"enum": ["info", "blocking"]},
        "field_ids": {"type": "array", "items": {"$ref": "#/$defs/name"}},
        "rule_ids": {"type": "array", "items": {"$ref": "#/$defs/name"}},
        "source_ids": {"type": "array", "items": {"$ref": "#/$defs/name"}},
        "refs": {"type": "array", "items": {"$ref": "#/$defs/inputRef"}}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "aspect", "state", "actor_id", "actor_kind", "reviewed_at", "evidence"],
      "properties": {
        "subject": {"oneOf": [{"$ref": "#/$defs/name"}, {"$ref": "#/$defs/inputRef"}]},
        "aspect": {"enum": ["transcription", "source_validity", "business_authorization"]},
        "state": {"enum": ["verified", "rejected", "needs_review"]},
        "actor_id": {"$ref": "#/$defs/name"},
        "actor_kind": {"enum": ["human", "system"]},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/inputRef"}}
      }
    }
  }
}
