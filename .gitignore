# La Caja esta commiteada, pero en caja_de_alberto/vN: instantaneas con
# manifiesto de lo que publica la organizacion. Lo que se ignora es la copia
# VIVA, `caja/`, porque la subida web escribe dentro y no queremos los PDF
# subidos en la historia. Se siembra con `make caja`.
caja/
500-sombras-de-alberto/

venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# Artefactos de las herramientas de main
benchmark/runs/
benchmark/review/pages/
.claude_erp.log
backend/data/

# Estado y salidas: se regeneran con `alberto todo`
alberto.db
alberto.db-wal
alberto.db-shm
outcomes*.jsonl

# El ejemplo que nos pasaron, conservado como referencia
legacy/

# Paginas rasterizadas de la fase 2 (capa raw). Se regeneran.
raw/

# Las normas compiladas: las construye `make rules`. El README de la carpeta
# si se versiona; el JSON generado no, que cambia con cada perfil y con cada
# barrido y no es la fuente de nada.
rules_ingestion/outcome/**/rules.json
.env

nueva.db

# Frontend
frontend/node_modules/
frontend/.next/
