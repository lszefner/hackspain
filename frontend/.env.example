# Code required to pass the /access gate before viewing the site.
# Set as a Vercel project env var for real deployments; defaults to "albertito" locally.
SITE_ACCESS_CODE=albertito

# Canonical engine (make api → :8010). Used by /api/ingest and /api/engine/*.
ENGINE_API_BASE=http://127.0.0.1:8010

# Optional: where Agent stages PDFs before lanzar (defaults to ../caja/facturas).
# REVISION_INPUT_DIR=
